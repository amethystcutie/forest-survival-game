[sub_resource type="GDScript" id="GDScript_bgcxa"]
resource_name = "custom_player_model"
script/source = "extends PlayerModel

@onready var anim_player := $witch/AnimationPlayer

func _process(_delta: float) -> void:
	if anim_paused: anim_player.pause()
	else: anim_player.play(get_anim_name())

	$witch/Skeleton3D/ChibiWitch.transparency = 1 - opacity

func get_anim_name() -> String:
	match animation:
		\"idle\": 
			anim_player.pause()
			return \"\"
		\"walk\": return \"mixamo_com\"
		_: return \"\"
"

